{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.2.0",
  "name": "nostr-calendar/event-wall",
  "title": "Nostr Event Wall",
  "category": "widgets",
  "icon": "calendar",
  "description": "Zeigt Events aus dem Nostr-Netzwerk in einer Event-Wall an",
  "keywords": ["nostr", "events", "calendar"],
  "textdomain": "nostr-calendar-block",
  "supports": {
    "html": false,
    "customClassName": true,
    "align": ["wide", "full"]
  },
  "example": {
    "attributes": {
      "theme": "light",
      "showFilterbar": true,
      "limit": 1000
    }
  },
  "attributes": {
    "theme": {
      "type": "string",
      "default": "light",
      "enum": ["light", "dark", "relilab", "foerbico"]
    },
    "showFilterbar": {
      "type": "boolean",
      "default": true
    },
    "filter": {
      "type": "string",
      "default": ""
    },
    "relays": {
      "type": "array",
      "default": ["wss://relay-rpi.edufeed.org/"],
      "items": {
        "type": "string"
      }
    },
    "npub": {
      "type": "array",
      "default": ["npub12j35qpeve33929kg64etvw9g9rzms4c8g5gnqta58yhjdc6wryfse3phmu"],
      "items": {
        "type": "string"
      }
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "showAuthor": {
      "type": "boolean",
      "default": true
    },
    "limit": {
      "type": "number",
      "default": 1000,
      "minimum": 1,
      "maximum": 10000
    }
  }
}
